[Unit]
Description=Flight Display Web UI
After=NetworkManager.service flight-setup.service
Wants=NetworkManager.service flight-setup.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/flight-display/app
EnvironmentFile=-/etc/default/flight-display
ExecStart=/usr/bin/python3 /opt/flight-display/app/web.py
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=multi-user.target
