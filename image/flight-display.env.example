WAVESHARE_DRIVER=V4
DISPLAY_ROTATE=0
DEVICE_HOSTNAME=flight-display
SSH_USER=flight
SSH_PASSWORD=flight
WEB_USER=flight
WEB_PASSWORD=flight

# Optional first tracked flight and AirLabs API key.
# You can also set both from the web UI after boot.
# FLIGHT_NUMBER=BA123
# AIRLABS_API_KEY=your-api-key
# AIRLABS_URL=https://airlabs.co/api/v9/flight
# FLIGHT_POLL_SECONDS=600

# Optional Wi-Fi setup before first boot.
# WIFI_SSID=YourNetworkName
# WIFI_PASSWORD=YourNetworkPassword
# WIFI_COUNTRY=ZA
# WIFI_HIDDEN=0
